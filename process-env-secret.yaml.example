apiVersion: v1
kind: Secret
metadata:
  name: dph-process-env
  namespace: dph
type: Opaque
stringData:
  PROCESS_ENV: |
    {
      "cocoa-terrain": {
        "S3_BUCKET": "REPLACE_WITH_BUCKET",
        "S3_PREFIX": "cocoa-terrain",
        "S3_REGION": "us-east-1",
        "AWS_ACCESS_KEY_ID": "REPLACE_WITH_ACCESS_KEY",
        "AWS_SECRET_ACCESS_KEY": "REPLACE_WITH_SECRET_KEY"
      }
    }
